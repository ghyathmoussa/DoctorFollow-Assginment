LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=90
LLM_RETRY_ATTEMPTS=4
LLM_RETRY_BACKOFF_SECONDS=2.0
LLM_MIN_INTERVAL_SECONDS=6.0
RAG_ABSTRACT_CHAR_LIMIT=1200

PUBMED_EMAIL=your_email@example.com
PUBMED_TOOL_NAME=doctor-follow-assessment
PUBMED_RATE_LIMIT_PER_SEC=3
PUBMED_TIMEOUT_SECONDS=30
PUBMED_MAX_RESULTS=5
PUBMED_RETRY_ATTEMPTS=3
PUBMED_RETRY_BACKOFF_SECONDS=1.5

EMBEDDING_MODEL=intfloat/multilingual-e5-small
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
TOP_K=5

MEDICAL_TERMS_PATH=medical_terms.csv
ARTIFACTS_DIR=artifacts
CORPUS_PATH=artifacts/corpus.json
RETRIEVAL_CORPUS_PATH=artifacts/retrieval_corpus.json
